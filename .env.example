# Firma los JWT del panel. Obligatoria con DJANGO_DEBUG=false.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Obligatoria: cadena de conexión PostgreSQL de Neon. No hay otra base de datos.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LANDING_URL=http://localhost:3000
ROOT_DOMAIN=delismart.publicvm.com
# Solo el panel admin. El landing se autoriza aparte, con LANDING_URL y únicamente para /api/stripe/.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Producción: el panel admin es https://deli-smart-admin-saa-s.vercel.app
# y el landing https://deli-smart-landing.vercel.app (va en LANDING_URL).
DEFAULT_FROM_EMAIL=DeliSmart <no-reply@delismart.publicvm.com>

# Panel de la pollería. Producción: https://deli-smart-restaurant-front.vercel.app (valor por defecto).
RESTAURANT_FRONT_URL=http://localhost:5174
# Mismo valor que INTERNAL_API_TOKEN de delismart-restaurant-back. Autoriza /api/internal/licencias/
# y firma el acceso directo desde Mi Plan. Sin él, el botón "Abrir panel" responde 503.
INTERNAL_API_TOKEN=
